{
  "manifest_version": 3,
  "name": "Cyber Threat Detector",
  "version": "1.0",
  "description": "Ekstensi Pendeteksi Phishing, Judol, dan Threat",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://cyber-threat-detector-theta.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}